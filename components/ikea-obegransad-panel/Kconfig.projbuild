menu "Driver for IKEA Obegransad Panel"

    choice OBG_PANEL_BACKEND
        prompt "Panel backend"
        default OBG_PANEL_BACKEND_SIM if OBG_SIMULATOR
        default OBG_PANEL_BACKEND_HW
        help
            Hardware uses SPI + RMT + GPIO shift-register output. The
            simulator publishes frames to the host renderer and touches no
            peripherals (for QEMU/host builds).

    config OBG_PANEL_BACKEND_HW
        bool "Hardware (SPI + RMT + GPIO)"

    config OBG_PANEL_BACKEND_SIM
        bool "Simulator (framebuffer over TCP)"
    endchoice

    config MY_DISPLAY_OE_PIN
        int "OE Pin"
        default 6
        help
            GPIO number for Output Enable (OE) pin.

    config MY_DISPLAY_DI_PIN
        int "DI Pin"
        default 5
        help
            GPIO number for Data In (DI) pin.

    config MY_DISPLAY_CLK_PIN
        int "CLK Pin"
        default 4
        help
            GPIO number for Clock (CLK) pin.

    config MY_DISPLAY_LATCH_PIN
        int "LATCH Pin"
        default 3
        help
            GPIO number for Latch (LATCH) pin.

endmenu

main/status_led.cpp --- C++
 1 #include "status_led.hpp"
 2 
 3 #include "device.h"
 4 
 5 #include <driver/gpio.h>
 6 #include <esp_check.h>
 7 #include <esp_log.h>
 8 
 9 static const char *TAG = "status_led";
10 
11 namespace {
12 constexpr uint32_t STATUS_LED_ON_LEVEL = 1;
13 constexpr uint32_t STATUS_LED_OFF_LEVEL = 0;
14 
15 uint32_t wifi_connected_to_led_level(bool connected) {
16   return connected ? STATUS_LED_OFF_LEVEL : STATUS_LED_ON_LEVEL;
17 }
18 } // namespace
19 
20 esp_err_t status_led_init() {
21   ESP_RETURN_ON_ERROR(gpio_reset_pin(STATUS_LED_PIN), TAG,
22                       "Failed to reset status LED pin");
23   ESP_RETURN_ON_ERROR(gpio_set_direction(STATUS_LED_PIN, GPIO_MODE_OUTPUT), TAG,
24                       "Failed to set status LED pin direction");
25 
26   // Default to ON until Wi-Fi reaches the connected state.
27   ESP_RETURN_ON_ERROR(gpio_set_level(STATUS_LED_PIN,
28                                      wifi_connected_to_led_level(false)),
29                       TAG, "Failed to set initial status LED state");
30   return ESP_OK;
31 }
32 
33 void status_led_set_wifi_connected(bool connected) {
34   const esp_err_t err =
35       gpio_set_level(STATUS_LED_PIN, wifi_connected_to_led_level(connected));
36   if (err != ESP_OK) {
37     ESP_LOGE(TAG, "Failed to update status LED: %s", esp_err_to_name(err));
38   }
39 }
40 


# Application defaults shared by every target (chip builds and the Linux host
# simulator). Target-specific settings live in sdkconfig.defaults.<target>,
# which ESP-IDF applies automatically; secrets and personal config live in the
# gitignored sdkconfig.defaults.local. Later files take precedence.
#
# This file intentionally does not pin CONFIG_IDF_TARGET: for a fresh checkout
# run `idf.py set-target esp32c3` before building for the board (the simulator
# runners pass -DIDF_TARGET=... themselves).

# Enable certificate bundle for secure HTTPS requests
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# Enable HTTP client with HTTPS support
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y

# Http Server
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# TLS optimizations for better connection reliability
CONFIG_MBEDTLS_SSL_MAX_CONTENT_LEN=4096
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=4096
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096

# v6 treats default compiler warnings as errors; several third-party components
# (panel, managed components) have benign warnings. Keep warnings non-fatal.
CONFIG_COMPILER_DISABLE_DEFAULT_ERRORS=y

# Log level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Obegransad app configuration (see main/Kconfig.projbuild).
# Set your WiFi SSID below; with an empty SSID the device stays offline
# (there is no captive portal anymore, see docs/known-issues.md).
CONFIG_OBG_WIFI_SSID=""
CONFIG_OBG_WIFI_PASSWORD=""
# OTA token for POST /api/ota. Set a real value in sdkconfig.defaults.local;
# an empty token disables OTA. tools/ota-push.sh reads it from there.
CONFIG_OBG_OTA_TOKEN=""
CONFIG_OBG_TIMEZONE="CET-1CEST,M3.5.0,M10.5.0/3"
CONFIG_OBG_WEATHER_LATITUDE="0.0"
CONFIG_OBG_WEATHER_LONGITUDE="0.0"
CONFIG_OBG_ANNIVERSARY_DAY=1
CONFIG_OBG_ANNIVERSARY_MONTH=1
CONFIG_OBG_SCENE_DWELL_MS=10000
